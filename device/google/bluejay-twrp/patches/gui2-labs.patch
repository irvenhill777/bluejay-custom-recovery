diff --git a/gui2/pages/labs_page.cpp b/gui2/pages/labs_page.cpp
new file mode 100644
index 0000000..6075717
--- /dev/null
+++ b/gui2/pages/labs_page.cpp
@@ -0,0 +1,47 @@
+#include "pages/labs_page.h"
+
+#include <algorithm>
+#include <iterator>
+
+#include "components/section_label.h"
+#include "components/setting_card.h"
+#include "components/tip_card.h"
+
+namespace gui2_pages {
+
+void build_labs_page(const labs_page_options& options) {
+  if (options.content == nullptr || options.metrics == nullptr || options.strings == nullptr ||
+      options.features == nullptr || options.result_label == nullptr)
+    return;
+
+  const auto& metrics = *options.metrics;
+  const auto& strings = *options.strings;
+  gui2_components::create_tip_card(options.content, metrics, strings.labs_warning, metrics.danger,
+                                   metrics.danger_surface);
+
+  *options.result_label = lv_label_create(options.content);
+  lv_label_set_text(*options.result_label, strings.labs_initial_result);
+  lv_label_set_long_mode(*options.result_label, LV_LABEL_LONG_WRAP);
+  lv_obj_set_width(*options.result_label, std::max(1, metrics.content_width));
+  lv_obj_set_style_text_color(*options.result_label, metrics.secondary_text, LV_PART_MAIN);
+  lv_obj_set_style_text_font(*options.result_label, metrics.status_font, LV_PART_MAIN);
+
+  gui2_components::create_section_label(options.content, metrics, strings.labs_section);
+  const gui2_i18n::action_text entries[] = {
+      { strings.labs_otg_title, strings.labs_otg_summary, "" },
+      { strings.labs_dynamic_title, strings.labs_dynamic_summary, "" },
+      { strings.labs_package_title, strings.labs_package_summary, "" },
+      { strings.labs_backup_title, strings.labs_backup_summary, "" },
+      { strings.labs_touch_title, strings.labs_touch_summary, "" },
+      { strings.labs_bundle_title, strings.labs_bundle_summary, "" },
+      { strings.labs_compat_title, strings.labs_compat_summary, "" },
+  };
+  const size_t count = std::min(options.feature_count, std::size(entries));
+  for (size_t i = 0; i < count; ++i) {
+    gui2_components::create_setting_card(
+        options.content, metrics, entries[i].title, entries[i].summary, options.event_callback,
+        &options.features[i], options.press_guard_callback);
+  }
+}
+
+}  // namespace gui2_pages
