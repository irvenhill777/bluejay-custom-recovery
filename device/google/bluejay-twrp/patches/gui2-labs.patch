diff --git a/gui2/backend/labs_backend.cpp b/gui2/backend/labs_backend.cpp
new file mode 100644
index 0000000..1ed8f45
--- /dev/null
+++ b/gui2/backend/labs_backend.cpp
@@ -0,0 +1,196 @@
+#include "backend/labs_backend.h"
+
+#include <dirent.h>
+#include <cerrno>
+#include <cstring>
+#include <sys/stat.h>
+#include <sys/sysmacros.h>
+
+#include <android-base/properties.h>
+
+#include <algorithm>
+#include <fstream>
+#include <iterator>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace gui2_backend {
+namespace {
+
+bool directory_entries(const char* path, std::vector<std::string>* entries, std::string* error) {
+  if (entries == nullptr || error == nullptr) return false;
+  entries->clear();
+  DIR* directory = opendir(path);
+  if (directory == nullptr) {
+    *error = std::strerror(errno);
+    return false;
+  }
+
+  errno = 0;
+  while (dirent* entry = readdir(directory)) {
+    const std::string name(entry->d_name);
+    if (name != "." && name != "..") entries->push_back(name);
+  }
+  const int read_error = errno;
+  closedir(directory);
+  if (read_error != 0) {
+    entries->clear();
+    *error = std::strerror(read_error);
+    return false;
+  }
+  std::sort(entries->begin(), entries->end());
+  return true;
+}
+
+std::string read_file(const std::string& path) {
+  std::ifstream input(path);
+  std::string value;
+  if (input >> value) return value;
+  return {};
+}
+
+std::string otg_report() {
+  std::ostringstream report;
+  report << "Read-only USB host diagnostics\n";
+
+  std::vector<std::string> devices;
+  std::string error;
+  if (!directory_entries("/sys/bus/usb/devices", &devices, &error)) {
+    report << "USB device details unavailable: " << error << ".\n";
+    return report.str();
+  }
+  size_t found = 0;
+  for (const auto& device : devices) {
+    const std::string path = "/sys/bus/usb/devices/" + device;
+    const std::string vendor = read_file(path + "/idVendor");
+    const std::string product = read_file(path + "/idProduct");
+    if (vendor.empty() || product.empty()) continue;
+    report << "USB device " << device << ": " << vendor << ":" << product;
+    const std::string name = read_file(path + "/product");
+    if (!name.empty()) report << " (" << name << ")";
+    report << "\n";
+    ++found;
+  }
+
+  if (found == 0) report << "No USB devices are currently reported by sysfs.\n";
+  std::ifstream mounts("/proc/mounts");
+  if (!mounts) {
+    report << "Current mount state is unavailable.\n";
+  } else {
+    std::string line;
+    size_t shown_mounts = 0;
+    while (std::getline(mounts, line)) {
+      std::istringstream fields(line);
+      std::string source;
+      std::string destination;
+      std::string file_system;
+      if (!(fields >> source >> destination >> file_system)) continue;
+      if (source.rfind("/dev/block/sd", 0) != 0 && source.rfind("/dev/block/usb", 0) != 0)
+        continue;
+      report << "Removable block mount: " << source << " at " << destination << " ("
+             << file_system << ")\n";
+      if (++shown_mounts == 16) {
+        report << "Additional removable mounts omitted.\n";
+        break;
+      }
+    }
+    if (shown_mounts == 0) report << "No removable USB block mounts are listed.\n";
+  }
+  report << "No media was mounted or changed.\n";
+  return report.str();
+}
+
+std::string dynamic_partition_report() {
+  std::ostringstream report;
+  report << "Read-only logical block-device view\n";
+
+  std::vector<std::string> devices;
+  std::string error;
+  if (!directory_entries("/dev/block/mapper", &devices, &error)) {
+    report << "Logical mapper details unavailable: " << error << ".\n";
+    report << "No partition or mapping was changed.\n";
+    return report.str();
+  }
+  if (devices.empty()) {
+    report << "No logical mapper devices are visible in this recovery.\n";
+    report << "Group capacity/free-space data is unavailable without lpdump support.\n";
+    report << "No partition or mapping was changed.\n";
+    return report.str();
+  }
+
+  size_t shown = 0;
+  for (const auto& name : devices) {
+    if (name == "control") continue;
+    if (shown == 32) {
+      report << "Additional mapper entries omitted.\n";
+      break;
+    }
+
+    const std::string device_path = "/dev/block/mapper/" + name;
+    struct stat status {};
+    report << name;
+    if (stat(device_path.c_str(), &status) == 0 && S_ISBLK(status.st_mode)) {
+      const std::string size_path = "/sys/dev/block/" + std::to_string(major(status.st_rdev)) +
+                                    ":" + std::to_string(minor(status.st_rdev)) + "/size";
+      const std::string sectors = read_file(size_path);
+      if (!sectors.empty()) report << " (" << sectors << " sectors)";
+    } else {
+      report << " (size unavailable)";
+    }
+    report << "\n";
+    ++shown;
+  }
+  report << "Logical group capacity/free space is not reported by this view.\n";
+  report << "No partition or mapping was changed.\n";
+  return report.str();
+}
+
+std::string property_value(const char* key) {
+  const std::string value = android::base::GetProperty(key, "");
+  return value.empty() ? "not reported" : value;
+}
+
+std::string compatibility_report() {
+  std::ostringstream report;
+  report << "Read-only recovery compatibility report\n"
+         << "Device: " << property_value("ro.product.device") << "\n"
+         << "Model: " << property_value("ro.product.model") << "\n"
+         << "Build: " << property_value("ro.build.display.id") << "\n"
+         << "Android release: " << property_value("ro.build.version.release") << "\n"
+         << "Recovery: " << property_value("ro.twrp.version") << "\n"
+         << "Active slot: " << property_value("ro.boot.slot_suffix") << "\n"
+         << "This report does not verify image compatibility or bootability.\n";
+  return report.str();
+}
+
+}  // namespace
+
+std::string labs_report(lab_feature feature) {
+  switch (feature) {
+    case lab_feature::OTG_DIAGNOSTICS:
+      return otg_report();
+    case lab_feature::DYNAMIC_PARTITIONS:
+      return dynamic_partition_report();
+    case lab_feature::PACKAGE_PREFLIGHT:
+      return "Package preflight uses the existing installer selection and review flow. "
+             "Metadata is advisory; only the installer's explicit verification result "
+             "describes signature verification.";
+    case lab_feature::BACKUP_VERIFICATION:
+      return "Standalone checksum scanning is unavailable in this build. No backup was "
+             "opened and no restore was started. Do not start a restore just to test a "
+             "backup checksum.";
+    case lab_feature::TOUCH_DISPLAY:
+      return "Touch input was received. This screen does not change brightness, rotation, "
+             "or partition settings.";
+    case lab_feature::DIAGNOSTIC_BUNDLE:
+      return "The existing log export can include selected recovery, kernel, and logcat "
+             "logs. Automatic redaction and a complete export preview are unavailable; "
+             "logs may contain personal or device identifiers.";
+    case lab_feature::COMPATIBILITY_REPORT:
+      return compatibility_report();
+  }
+  return "Unknown Labs feature.";
+}
+
+}  // namespace gui2_backend
