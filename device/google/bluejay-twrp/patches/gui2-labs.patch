+static void labs_option_event_cb(lv_event_t* event) {
+  if (lv_event_get_code(event) != LV_EVENT_CLICKED || !accept_click(event)) return;
+  const auto* feature =
+      static_cast<const gui2_backend::lab_feature*>(lv_event_get_user_data(event));
+  if (feature == nullptr) return;
+
+  if (*feature == gui2_backend::lab_feature::PACKAGE_PREFLIGHT) {
+    page_state.labs_result_label = nullptr;
+    page_state.install_queue.clear();
+    page_state.install_from_file_manager = false;
+    page_state.install_repack = false;
+    navigate_to(page_kind::INSTALL);
+    return;
+  }
+  if (*feature == gui2_backend::lab_feature::DIAGNOSTIC_BUNDLE) {
+    page_state.labs_result_label = nullptr;
+    navigate_to(page_kind::EXPORT_LOG);
+    return;
+  }
+  if (page_state.labs_result_label == nullptr) return;
+
+  std::string report = gui2_backend::labs_report(*feature);
+  if (*feature == gui2_backend::lab_feature::TOUCH_DISPLAY) {
+    lv_indev_t* input = lv_event_get_indev(event);
+    if (input != nullptr) {
+      lv_point_t point{};
+      lv_indev_get_point(input, &point);
+      report += "\nTouch sample: (" + std::to_string(point.x) + ", " +
+                std::to_string(point.y) + ")";
+    }
+    lv_display_t* display = lv_display_get_default();
+    if (display != nullptr) {
+      report += "\nPanel: " + std::to_string(lv_display_get_horizontal_resolution(display)) +
+                " x " + std::to_string(lv_display_get_vertical_resolution(display));
+    }
+  }
+  lv_label_set_text(page_state.labs_result_label, report.c_str());
+}
